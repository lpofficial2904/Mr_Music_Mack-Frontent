{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "vite build && vite build --ssr src/entry-server.jsx --outDir .prerender && node scripts/prerender.mjs",
    "generate:demos": "node scripts/generate-demos.mjs",
    "test": "node scripts/verify-build.mjs",
    "lint": "oxlint",
    "preview": "vite preview",
    "format": "prettier --write src scripts index.html vite.config.js"
  },
  "dependencies": {
    "framer-motion": "^13.4.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-helmet-async": "^3.0.0",
    "react-hot-toast": "^2.6.1",
    "react-router-dom": "^6.30.1",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "prettier": "3.6.2",
    "vite": "^8.3.0"
  }
}
